have(){
    command -v $1 2> /dev/null && echo -n $1
}

WGET=$(have wget)
CURL=$(have curl)
APT=$(have apt-get)
APK=$(have apk)
YUM=$(have yum)
PACMAN=$(have pacman)


RED='\033[0;31m'
GREEN='\033[0;32m' 
NC='\033[0m' # No Color


red() {
    printf "${RED}$@${NC}\n"
}

green() {
    printf "${GREEN}$@${NC}\n"
}


install(){
    if   [ ! -z "$APT" ] ; then
        apt-get update
        apt-get install -y $1
    elif [ ! -z "$APK" ] ; then 
        apk upgrade
        apk add $1
    elif [ ! -z "$YUM" ] ; then 
        yum -y install $1
    elif [ ! -z "$PACMAN" ] ; then 
        yes | pacman -Syu $1
    fi
}

append_file(){
    #sh -c 'echo "$1" >> $2'
    touch "$2"
    echo "$1" | tee -a "$2" > /dev/null
}

set_env(){
    E=$1
    if [ ! -f  /etc/environment ] || ! grep -q -e "$E" /etc/environment ; then 
        append_file "$E" /etc/environment
    fi
    export "$E"
}

install_cert() {

    echo "$CERT1" > "$1"
    echo "$CERT2" > "$2"
    echo "$CERT3" > "$3"
    echo "$CERT4" > "$4"
    echo "$CERT5" > "$5"
 

    command -v "update-ca-certificates" 2> /dev/null || (
        install ca-certificates
        update-ca-certificates
    )

    BUNDLE=

    if [ -f /etc/pki/tls/certs/ca-bundle.crt ]; then 
        BUNDLE=/etc/pki/tls/certs/ca-bundle.crt
    fi

    if [ -f /etc/ssl/certs/ca-certificates.crt ]; then 
        BUNDLE=/etc/ssl/certs/ca-certificates.crt
    fi

    DIRCA=

    if [ -d /usr/local/share/ca-certificates ]; then 
        DIRCA=/usr/local/share/ca-certificates
    fi

    if [ -d /etc/pki/ca-trust/source/anchors ]; then 
        DIRCA=/etc/pki/ca-trust/source/anchors
    fi

    if [ -d /etc/ca-certificates/trust-source/anchors ]; then 
        DIRCA=/etc/ca-certificates/trust-source/anchors
    fi 


    if [ ! -z "$DIRCA" ] ; then
        for CERTFILE in "$@"; do
            ln -sf "$CERTFILE" "${DIRCA}/"
        done 
        if [ ! -z "$(have  update-ca-certificates )" ] ; then
            update-ca-certificates
        fi
        if [ ! -z "$(have update-ca-trust )" ]; then
            update-ca-trust
        fi
    fi

    CERTS1L=$(cat "$BUNDLE" | tr -d \\n\\r)

    for CERTFILE in "$@"; do

        CERT1L=$(cat "$CERTFILE" | tr -d \\n\\r)
        if echo "$CERTS1L" | grep -q -e "$CERT1L" ; then
            echo "installed in bundle"
        else        
            cat "$CERTFILE" >> "$BUNDLE"
        fi
    done 
    

    ln -s "$BUNDLE" /etc/ca-bundle.crt

    # for nodejs
    set_env "NODE_EXTRA_CA_CERTS=/etc/ca-bundle.crt"

    # for requests python
    set_env "REQUESTS_CA_BUNDLE=/etc/ca-bundle.crt" 

    # for python
    set_env "SSL_CERT_FILE=/etc/ca-bundle.crt" 

    # for curl 
    set_env "CURL_CA_BUNDLE=/etc/ca-bundle.crt"
}

set_env_profile() {
    if [ -d /etc/profile.d ]; then
        if [ ! -f /etc/profile.d/netfree-env.sh ]; then 
            echo "# NetFree CA certificates environment variables" > /etc/profile.d/netfree-env.sh
            echo "[ -f /etc/environment ] && . /etc/environment" >> /etc/profile.d/netfree-env.sh
            chmod 644 /etc/profile.d/netfree-env.sh
            green "Added to /etc/profile.d/ - all users will get environment variables"
        fi
    elif [ -f /etc/profile ]; then
        # Fallback for systems without /etc/profile.d/
        if ! grep -q "NetFree CA certificates environment" /etc/profile; then
            echo "" >> /etc/profile
            echo "# NetFree CA certificates environment variables" >> /etc/profile
            echo "[ -f /etc/environment ] && . /etc/environment" >> /etc/profile
            green "Added to /etc/profile - all users will get environment variables"
        fi
    else
        red "Warning: Could not add to system profile. Please add manually:"
        red "  source /etc/environment"
    fi
}

test_install() {

    if [ -z "$CURL" ] ; then
        install curl
        CURL=$(have curl)
    fi

    TEST=
    if [ ! -z "$CURL" ] ; then
        TEST=$(curl https://certx2.internal.netfree.link/user/0 2>&1 )  
    else
        TEST=$(wget -O - https://certx2.internal.netfree.link/user/0 2>&1 )
    fi

    if echo "$TEST" | grep -q "userKey" ; then
        green "Certificate works successfully"
    elif echo "$TEST" | grep -q "unable to get local issuer" ; then
        red "Certificate error"
        exit 1
    else
        red "Some error"
    fi
}

mkdir -p /opt/netfree/ca/

echo "$CERT1" > /opt/netfree/ca/united-x2.crt
echo "$CERT2" >> /opt/netfree/ca/united-x2.crt
echo "$CERT3" >> /opt/netfree/ca/united-x2.crt
echo "$CERT4" >> /opt/netfree/ca/united-x2.crt
echo "$CERT5" >> /opt/netfree/ca/united-x2.crt

mkdir -p /opt/netfree/ca/list/

install_cert /opt/netfree/ca/list/netfree-united-x2-ed25519.crt \
/opt/netfree/ca/list/netfree-united-x2-p-256.crt \
/opt/netfree/ca/list/netfree-united-x2-p-384.crt \
/opt/netfree/ca/list/netfree-united-x2-rsa.crt \
/opt/netfree/ca/list/netfree-united-x2-rsa-2037.crt

set_env_profile
test_install